@model EmployeesManagement.Models.Instrument
@{ ViewData["Title"]="Delete"; }
<div class="card"><div class="card-header"><h3>Delete Instrument</h3></div><div class="card-body">
<p class="text-danger">Are you sure you want to delete this instrument?</p>
<dl class="row">
<dt class="col-sm-3">Instrument Type</dt><dd class="col-sm-9">@Model.TipoInstrumento</dd>
<dt class="col-sm-3">Instrument Name</dt><dd class="col-sm-9">@Model.Nome</dd>
<dt class="col-sm-3">Uses Strings?</dt><dd class="col-sm-9">@(Model.UsaCordas ? "Yes" : "No")</dd>
</dl>
<form asp-action="Delete"><input type="hidden" asp-for="Id"/><button class="btn btn-danger">Confirm Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
</div></div>